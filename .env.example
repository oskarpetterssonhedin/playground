# Copy to .env.local for local production testing. Set real values in Vercel
# (Project → Settings → Environment Variables) for Production and Preview.

# Password for the site-wide gate (production only; no gate in `pnpm dev`).
SITE_PASSWORD=

# Long random string used to sign the session cookie. Generate with:
#   openssl rand -base64 32
# Changing it (or SITE_PASSWORD) signs everyone out.
AUTH_SECRET=

# Local-only: bypasses the gate on a local production server so
# `pnpm thumbnails` can capture pages. Set automatically by the script.
# NEVER set this in Vercel (it is ignored there anyway).
# THUMBNAIL_CAPTURE=1

# AI-backed prototypes (server-side only, never NEXT_PUBLIC_). Add as needed.
# ANTHROPIC_API_KEY=
